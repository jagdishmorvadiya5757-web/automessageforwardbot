# Copy to .env and fill in. Never commit the real .env.

# Public URL of THIS gateway (VM public IP or domain). Must be reachable from browsers.
API_EXTERNAL_URL=http://137.23.33.160:8000
SITE_URL=https://automessageforwardbot.lovable.app
ADDITIONAL_REDIRECT_URLS=https://automessageforwardbot.lovable.app,https://id-preview--204f9241-6b8e-49b4-857b-d4d169778e2a.lovable.app,http://localhost:8080

# Long random string (>= 40 chars). Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Database connections (host Postgres reached from inside Docker)
GOTRUE_DB_URL=postgres://supabase_auth_admin:AUTH_PASSWORD@host.docker.internal:5432/forwardflow
POSTGREST_DB_URL=postgres://authenticator:AUTHENTICATOR_PASSWORD@host.docker.internal:5432/forwardflow

# Email confirmation: "true" = users sign in immediately, no email needed.
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@forwardflow.local

# Google OAuth (optional)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
