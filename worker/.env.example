# URL of your ForwardFlow dashboard (shown on the Worker page)
API_BASE_URL=https://your-app-url

# MASTER worker token (Admin → Worker page → Reveal master token)
WORKER_TOKEN=

# From https://my.telegram.org (API development tools)
TG_API_ID=
TG_API_HASH=

# How often (seconds) to refresh rules from the dashboard
POLL_INTERVAL=30

# How often (seconds) to poll the dashboard for login/sync commands
LOGIN_POLL_INTERVAL=3
